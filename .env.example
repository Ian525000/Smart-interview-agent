# 复制本文件为 .env 后填写，切勿把真实密钥提交到 Git。
# copy .env.example .env   (Windows)
# cp .env.example .env     (macOS / Linux)

# 服务端口（避免与其他项目 8000 冲突）
SERVER_PORT=8001

# LLM 配置（OpenAI 兼容 API，如阿里云 DashScope / OpenAI / 其他兼容服务）
# 必填：在下方填入你自己的密钥，不要使用示例占位符启动服务
LLM_API_KEY=your_api_key_here
LLM_MODEL_ID=qwen-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=120

# TTS 语音角色（edge-tts）
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ASR 模型（faster-whisper）
WHISPER_MODEL=base

# 录音最长时长（秒）
MAX_RECORD_SECONDS=120

# 追问与评分配置
MAX_FOLLOW_UPS=3
FOLLOW_UP_QUESTION_COUNT=3
REFLECTION_ROUNDS=2
VAD_SILENCE_MS=2500
