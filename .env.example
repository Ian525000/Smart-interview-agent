# 首次使用：复制为 .env，再填写自己的配置。已有 .env 时不要覆盖。
# 本文件只能包含占位符，真实密钥、简历和录音不得提交到 Git。

# 服务端口（避免与其他项目 8000 冲突）
SERVER_PORT=8001

# LLM 配置（OpenAI 兼容 Chat Completions API，三项必须匹配）
# 以下模型/地址仅为示例，请按自己的服务商、地区及账号权限填写。
LLM_API_KEY=your_api_key_here
LLM_MODEL_ID=qwen-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TIMEOUT=120

# TTS 语音角色
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ASR 模型（需额外安装 faster-whisper，首次使用需要下载模型）
WHISPER_MODEL=base

# 每次录音最长时长（秒），到时停止，不自动提交回答
MAX_RECORD_SECONDS=120
# 追问配置
MAX_FOLLOW_UPS=3
FOLLOW_UP_QUESTION_COUNT=3
REFLECTION_ROUNDS=2
VAD_SILENCE_MS=2500
